# 이 파일을 복사해 .env 로 저장하고 = 뒤에 값을 붙여 넣기 (.env 는 git 에 올라가지 않음)

# 네이버 검색 API — tools/collect-naver.mjs
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 일반 인증키(Decoding) — tools/enrich-license.mjs
DATAGO_KEY=

# 챗봇 문서 임베딩 (https://console.upstage.ai/api-keys). 비우면 Ollama bge-m3
UPSTAGE_API_KEY=

# 챗봇 답변 (ChatGPT). 비우면 Ollama exaone3.5:2.4b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
